# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ML model asset — the same hand_landmarker.task the engine uses. Copied at setup
# rather than committed: it is a 7.5 MB binary and derivable (the engine downloads
# it on first run). See README.md "Running".
android/app/src/main/assets/*.task
